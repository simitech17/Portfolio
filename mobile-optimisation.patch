+
+/* Tablet and phone refinements follow the shared publications styles. */
+@media (max-width: 980px) {
+    .publications-hero, .publications-tools, .publications-list-section,
+    .publications-rule { width: calc(100% - 60px); }
+    .publications-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
+    .publications-hero { padding: 72px 0 64px; }
+    .publications-title { font-size: clamp(52px, 8vw, 76px); }
+}
+
+.publication-filter { min-height: 44px; min-width: 44px; padding: 10px 4px; }
+.publication-meta span { overflow-wrap: anywhere; }
+.publication-title-row { overflow-wrap: anywhere; }
+
+@media (max-width: 720px) {
+    .publications-hero, .publications-tools, .publications-list-section,
+    .publications-rule { width: calc(100% - 40px); }
+    .publications-hero { padding: 48px 0; }
+    .publications-kicker { margin-bottom: 22px; }
+    .publications-title { font-size: clamp(42px, 13vw, 76px); }
+    .publications-intro p { font-size: 17px; }
+    .publications-stat { margin-top: 24px; }
+    .publications-tools { padding: 32px 0; }
+    .publications-search { min-width: 0; font-size: 16px; }
+    .publication-filters { gap: 8px 16px; margin-top: 20px; }
+    .publications-list-section { padding: 12px 0 64px; }
+    .publication-row { grid-template-columns: 24px minmax(0, 1fr) 18px; gap: 12px; }
+    .publication-title-row { font-size: clamp(22px, 6vw, 26px); }
+}
+
+@media (hover: none) {
+    .work-row:hover, .publication-row:hover { padding-left: 0; }
+    .photo-frame:hover .profile-photo { transform: none; }
+}
+
+.form-group :is(input, textarea):focus-visible,
+.publications-search:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 4px;
+}
